// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Bowling {
  id          Int          @id @default(autoincrement())
  name        String
  tournaments Tournament[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("bowling")
}

model Tournament {
  id                       Int                       @id @default(autoincrement())
  name                     String
  bowlingId                Int
  bowling                  Bowling                   @relation(fields: [bowlingId], references: [id])
  sessions                 Session[]
  teams                    Team[]
  groups                   TournamentGroup[]
  playerCategories         PlayerCategory[]
  playerTournamentCategory PlayerTournamentCategory[]
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  @@map("tournaments")
}

model Team {
  id               Int              @id @default(autoincrement())
  tournamentId     Int
  name             String
  laneId           Int?             // Lane assigned to this team for the tournament
  groupId          Int?             // Group this team belongs to
  tournament       Tournament       @relation(fields: [tournamentId], references: [id])
  group            TournamentGroup? @relation(fields: [groupId], references: [id])
  teamPlayers      TeamPlayer[]
  matchesAsTeamA   SessionMatchup[] @relation("TeamAMatches")
  matchesAsTeamB   SessionMatchup[] @relation("TeamBMatches")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@map("teams")
}

model Player {
  id                       Int                        @id @default(autoincrement())
  name                     String
  teamPlayers              TeamPlayer[]
  playerTournamentCategory PlayerTournamentCategory[]
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt

  @@map("players")
}

model TeamPlayer {
  id                 Int                 @id @default(autoincrement())
  teamId             Int
  playerId           Int
  isReplacement      Boolean             @default(false)
  team               Team                @relation(fields: [teamId], references: [id])
  player             Player              @relation(fields: [playerId], references: [id])
  teamPlayerSessions TeamPlayerSession[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([teamId, playerId])
  @@map("team_players")
}

model Session {
  id                 Int                 @id @default(autoincrement())
  tournamentId       Int
  sessionDate        DateTime
  tournament         Tournament          @relation(fields: [tournamentId], references: [id])
  teamPlayerSessions TeamPlayerSession[]
  sessionMatchups    SessionMatchup[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@map("sessions")
}

model Lane {
  id                 Int                 @id @default(autoincrement())
  laneNumber         Int                 @unique
  opponentLaneId     Int?                @unique
  opponentLane       Lane?               @relation("LaneOpponents", fields: [opponentLaneId], references: [id])
  opposingLane       Lane?               @relation("LaneOpponents")
  sessionMatchups    SessionMatchup[]
  teamPlayerSessions TeamPlayerSession[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@map("lanes")
}

model SessionMatchup {
  id        Int      @id @default(autoincrement())
  sessionId Int
  laneId    Int      // Which lane this match is on
  teamAId   Int?     // Team assigned to this lane for this session
  teamBId   Int?     // Team on opponent lane for this session
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  lane      Lane     @relation(fields: [laneId], references: [id])
  teamA     Team?    @relation("TeamAMatches", fields: [teamAId], references: [id])
  teamB     Team?    @relation("TeamBMatches", fields: [teamBId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, laneId])
  @@map("session_matchups")
}

model TeamPlayerSession {
  id           Int        @id @default(autoincrement())
  teamPlayerId Int
  sessionId    Int
  laneId       Int
  line1        Int        @default(0)
  line2        Int        @default(0)
  line3        Int        @default(0)
  payment      Boolean    @default(false)
  handicap     Int        @default(0)
  assistance   Boolean    @default(false)
  teamPlayer   TeamPlayer @relation(fields: [teamPlayerId], references: [id])
  session      Session    @relation(fields: [sessionId], references: [id])
  lane         Lane       @relation(fields: [laneId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([teamPlayerId, sessionId])
  @@map("team_player_sessions")
}

model TournamentGroup {
  id           Int        @id @default(autoincrement())
  tournamentId Int
  name         String
  displayOrder Int        @default(0)
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teams        Team[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("tournament_groups")
}

model PlayerCategory {
  id                       Int                        @id @default(autoincrement())
  tournamentId             Int
  name                     String
  minAverage               Int?                       // Minimum average for auto-assignment
  maxAverage               Int?                       // Maximum average for auto-assignment
  displayOrder             Int                        @default(0)
  tournament               Tournament                 @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  playerTournamentCategory PlayerTournamentCategory[]
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt

  @@map("player_categories")
}

model PlayerTournamentCategory {
  id           Int            @id @default(autoincrement())
  playerId     Int
  tournamentId Int
  categoryId   Int
  isManual     Boolean        @default(false) // Whether manually assigned or auto-assigned
  player       Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)
  tournament   Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  category     PlayerCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([playerId, tournamentId])
  @@map("player_tournament_categories")
}
